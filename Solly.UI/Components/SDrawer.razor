@inherits SComponentBase
@implements IAsyncDisposable
@inject SollyInterop Interop

@if (_render)
{
    <div class="s-drawer-root @(_visible ? "s-in" : "s-out")" @ref="_root">
        <div class="s-drawer-backdrop" @onclick="OnBackdropAsync"></div>

        <div class="@Cls("s-drawer", SideClass)"
             style="@($"--s-drawer-w:{Width}")"
             role="dialog" aria-modal="true"
             @onkeydown="OnKeyDownAsync"
             @attributes="Attributes">

            @if (!string.IsNullOrEmpty(Title) || Closable)
            {
                <div class="s-drawer-head">
                    <span class="s-drawer-title">@Title</span>
                    @if (HeaderContent is not null) { @HeaderContent }
                    @if (Closable)
                    {
                        <button type="button" class="s-drawer-x" aria-label="Close" @onclick="CloseAsync">
                            <SIcon Name="@SIcons.X" Size="17" />
                        </button>
                    }
                </div>
            }

            <div class="s-drawer-body">@ChildContent</div>

            @if (FooterContent is not null)
            {
                <div class="s-drawer-foot">@FooterContent</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public SDrawerSide Side { get; set; } = SDrawerSide.Right;
    [Parameter] public string Width { get; set; } = "22rem";
    [Parameter] public bool Closable { get; set; } = true;
    [Parameter] public bool DismissOnBackdrop { get; set; } = true;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private bool _render;
    private bool _visible;
    private bool _lastOpen;
    private ElementReference _root;
    private DotNetObjectReference<SDrawer>? _self;
    private IJSObjectReference? _trap;
    private IJSObjectReference? _lock;
    private IJSObjectReference? _portal;

    private string SideClass => Side == SDrawerSide.Left ? "s-drawer-left" : "s-drawer-right";

    protected override async Task OnParametersSetAsync()
    {
        if (Open == _lastOpen) return;
        _lastOpen = Open;

        if (Open) await ShowAsync();
        else await HideAsync();
    }

    public async Task OpenAsync()
    {
        if (_render) return;
        _lastOpen = true;
        await ShowAsync();
        await OpenChanged.InvokeAsync(true);
    }

    public async Task CloseAsync()
    {
        if (!_render) return;
        _lastOpen = false;
        await HideAsync();
        await OpenChanged.InvokeAsync(false);
    }
    
    private async Task ShowAsync()
    {
        _render = true;
        StateHasChanged();
        await Task.Yield();
        _visible = true;
        StateHasChanged();

        _self ??= DotNetObjectReference.Create(this);
        try
        {
            _portal = await Interop.PortalAsync(_root);
            _lock = await Interop.LockScrollAsync();
            _trap = await Interop.TrapFocusAsync(_root, _self);
        }
        catch
        {
            // ignored
        }
    }

    private async Task HideAsync()
    {
        _visible = false; 
        StateHasChanged();

        await DisposeRefAsync(_trap); _trap = null;
        await DisposeRefAsync(_lock); _lock = null;

        await Task.Delay(260);
        
        await DisposeRefAsync(_portal); _portal = null;
        await Task.Yield();

        _render = false;
        StateHasChanged();
    }

    /// <summary>Called by the focus trap when Escape is pressed.</summary>
    [JSInvokable]
    public async Task OnEscapeAsync()
    {
        if (!Closable) return;
        await CloseAsync();
    }

    private async Task OnBackdropAsync()
    {
        if (DismissOnBackdrop && Closable) await CloseAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Closable) await CloseAsync();
    }

    private async ValueTask TeardownAsync()
    {
        await DisposeRefAsync(_trap);
        _trap = null;
        await DisposeRefAsync(_lock);
        _lock = null;
        await DisposeRefAsync(_portal);
        _portal = null;
    }

    private static async ValueTask DisposeRefAsync(IJSObjectReference? r)
    {
        try { if (r is not null) { await r.InvokeVoidAsync("dispose"); await r.DisposeAsync(); } }
        catch
        {
            // ignored
        }
    }

    public async ValueTask DisposeAsync()
    {
        await TeardownAsync();
        _self?.Dispose();
    }
}