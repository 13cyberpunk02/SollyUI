@using Solly.UI.Core.Interop
@inherits InputBase<DateTime?>
@inject SollyInterop Interop

<div class="s-field @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <SLabel Required="@Required">@Label</SLabel>
    }

    <SPopover @ref="_pop" OpenChanged="OnOpenChanged">
        <Anchor>
            <div class="s-dp-trigger s-glass @(Disabled ? "s-disabled" : null)"
                 tabindex="@(Disabled ? -1 : 0)"
                 @onclick="ToggleAsync"
                 @onkeydown="OnTriggerKeyDownAsync">
                <SIcon Name="@SIcons.Calendar" Class="s-dp-icon" />
                <span class="s-dp-value @(CurrentValue.HasValue ? null : "s-placeholder")">
                    @(CurrentValue?.ToString(Format) ?? Placeholder)
                </span>
                @if (Clearable && CurrentValue.HasValue && !Disabled)
                {
                    <button type="button" class="s-dp-clear" tabindex="-1"
                            aria-label="Clear" @onclick:stopPropagation="true" @onclick="ClearAsync">
                        <SIcon Name="@SIcons.X" Size="14" />
                    </button>
                }
            </div>
        </Anchor>

        <ChildContent>
            <div class="s-cal">
                <div class="s-cal-head">
                    <button type="button" class="s-cal-nav" @onclick="PrevMonth" aria-label="Previous month">
                        <SIcon Name="@SIcons.ChevronLeft" Size="16" />
                    </button>
                    <span class="S-cal-title">@_view.ToString("MMMM yyyy", Culture)</span>
                    <button type="button" class="s-cal-nav" @onclick="NextMonth" aria-label="Next month">
                        <SIcon Name="@SIcons.ChevronRight" Size="16" />
                    </button>
                </div>

                <div class="s-cal-grid">
                    @foreach (var d in DayNames)
                    {
                        <div class="s-cal-dow">@d</div>
                    }
                    @foreach (var day in Days())
                    {
                        var outside = day.Month != _view.Month;
                        var selected = CurrentValue?.Date == day.Date;
                        var today = day.Date == DateTime.Today;
                        var disabled = IsDisabled(day);

                        <button type="button"
                                class="s-cal-day @(outside ? "s-outside" : null) @(selected ? "s-selected" : null) @(today ? "s-today" : null)"
                                disabled="@disabled"
                                @onclick="() => PickAsync(day)">
                            @day.Day
                        </button>
                    }
                </div>
            </div>
        </ChildContent>
    </SPopover>

    @if (EditContext is not null)
    {
        <ValidationMessage For="@ValueExpression" class="s-error" />
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Pick a date…";
    [Parameter] public string Format { get; set; } = "dd.MM.yyyy";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private SPopover? _pop;
    private DateTime _view = DateTime.Today;

    private static System.Globalization.CultureInfo Culture
        => System.Globalization.CultureInfo.CurrentCulture;

    private static IEnumerable<string> DayNames
    {
        get
        {
            var first = (int)Culture.DateTimeFormat.FirstDayOfWeek;
            var names = Culture.DateTimeFormat.AbbreviatedDayNames;
            for (var i = 0; i < 7; i++) yield return names[(first + i) % 7];
        }
    }

    private IEnumerable<DateTime> Days()
    {
        var first = new DateTime(_view.Year, _view.Month, 1);
        var firstDow = (int)Culture.DateTimeFormat.FirstDayOfWeek;
        var offset = ((int)first.DayOfWeek - firstDow + 7) % 7;
        var start = first.AddDays(-offset);
        for (var i = 0; i < 42; i++) yield return start.AddDays(i);
    }

    private bool IsDisabled(DateTime d)
        => (Min.HasValue && d.Date < Min.Value.Date) || (Max.HasValue && d.Date > Max.Value.Date);

    private void OnOpenChanged(bool open)
    {
        if (open) _view = CurrentValue ?? DateTime.Today;
    }

    private async Task ToggleAsync()
    {
        if (Disabled || _pop is null) return;
        await _pop.ToggleAsync();
    }

    private async Task OnTriggerKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await ToggleAsync();
    }

    private void PrevMonth() => _view = _view.AddMonths(-1);
    private void NextMonth() => _view = _view.AddMonths(1);

    private async Task PickAsync(DateTime d)
    {
        CurrentValue = d.Date;
        if (_pop is not null) await _pop.CloseAsync();
    }

    private Task ClearAsync()
    {
        CurrentValue = null;
        return Task.CompletedTask;
    }

    protected override bool TryParseValueFromString(
        string? value, out DateTime? result, out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }
        if (DateTime.TryParse(value, Culture, out var d))
        {
            result = d;
            validationErrorMessage = null;
            return true;
        }
        result = null;
        validationErrorMessage = $"The {FieldIdentifier.FieldName} field is not a valid date.";
        return false;
    }
}