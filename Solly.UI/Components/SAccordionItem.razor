@inherits SComponentBase
@implements IDisposable

<div class="s-acc-item @(IsOpen ? "s-open" : null)">
    <button type="button"
            class="s-acc-header"
            disabled="@Disabled"
            aria-expanded="@(IsOpen ? "true" : "false")"
            @onclick="Toggle">

        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="s-acc-lead"><SIcon Name="@Icon" Size="17" /></span>
        }

        <span class="s-acc-title">
            @if (TitleContent is not null) { @TitleContent }
            else { @Title }
        </span>

        @if (Badge is not null)
        {
            <span class="s-acc-badge">@Badge</span>
        }

        <span class="s-acc-caret">
            <SIcon Name="@SIcons.ChevronDown" Size="16" Weight="2.2" />
        </span>
    </button>

    <div class="s-acc-panel">
        <div class="s-acc-body">
            <div class="s-acc-inner @(string.IsNullOrEmpty(Icon) ? null : "s-acc-inner-lead")">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private SAccordion? Parent { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public object? Badge { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool InitiallyOpen { get; set; }

    private ElementReference _body;

    internal bool IsOpen => Parent?.IsOpen(this) ?? false;

    protected override void OnInitialized()
    {
        if (Parent is null)
            throw new InvalidOperationException($"{nameof(SAccordionItem)} must be inside {nameof(SAccordion)}.");
        Parent.Register(this);
    }

    private void Toggle()
    {
        if (Disabled) return;
        Parent?.Toggle(this);
    }

    internal void NotifyStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Parent?.Unregister(this);
}