@inherits SComponentBase

<div class="@Cls("s-form-field", FullWidth ? "s-form-field-full" : null)"
     style="@Style" @attributes="Attributes">
    @ChildContent
    @if (!string.IsNullOrEmpty(Help))
    {
        <div class="s-form-field-help">@Help</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Help { get; set; }

    /// <summary>Span both columns in a 2-column section.</summary>
    [Parameter] public bool FullWidth { get; set; }
}