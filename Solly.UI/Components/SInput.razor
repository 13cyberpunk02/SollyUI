@inherits InputBase<string?>

<div class="s-field @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <SLabel For="@Uid" Required="@Required">@Label</SLabel>
    }

    <div class="s-input-wrap s-glass @(Disabled ? "s-disabled" : null)">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <SIcon Name="@Icon" Class="s-input-icon" />
        }

        <input id="@Uid"
               class="@Cls("s-input", CssClass)"
               type="@Type"
               placeholder="@Placeholder"
               disabled="@Disabled"
               value="@CurrentValueAsString"
               @oninput="OnInputAsync"
               @attributes="AdditionalAttributes" />

        @if (Clearable && !string.IsNullOrEmpty(CurrentValueAsString) && !Disabled)
        {
            <button type="button" class="s-input-clear" tabindex="-1"
                    aria-label="Clear" @onclick="Clear">
                <SIcon Name="@SIcons.X" Size="14" />
            </button>
        }
        
    </div>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="s-hint">@Hint</div>
    }
    @if (EditContext is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="s-error" />
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string Uid { get; } = $"s{Guid.NewGuid():N}"[..9];

    private System.Linq.Expressions.Expression<Func<string?>>? ValueExpressionOrNull
        => ValueExpression;

    private string Cls(params string?[] p) =>
        string.Join(' ', p.Where(x => !string.IsNullOrWhiteSpace(x)));

    private Task OnInputAsync(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        return Task.CompletedTask;
    }
    
    private void Clear() => CurrentValueAsString = null;

    protected override bool TryParseValueFromString(
        string? value, out string? result, out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }
}