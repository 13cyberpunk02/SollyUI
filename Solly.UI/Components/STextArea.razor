@inherits InputBase<string?>
@using Solly.UI.Core.Interop
@implements IAsyncDisposable
@inject SollyInterop Interop

<div class="s-field @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <SLabel For="@Uid" Required="@Required">@Label</SLabel>
    }

    <div class="s-ta-wrap s-glass @(Disabled ? "s-disabled" : null)">
        <textarea @ref="_ta" id="@Uid"
                  class="s-ta @CssClass"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  maxlength="@(MaxLength ?? int.MaxValue)"
                  style="@(AutoGrow ? "resize:none;overflow:hidden;" : null)"
                  value="@CurrentValueAsString"
                  @oninput="OnInputAsync"
                  @attributes="AdditionalAttributes"></textarea>
    </div>

    <div class="s-ta-foot">
        @if (!string.IsNullOrEmpty(Hint))
        {
            <span class="s-hint">@Hint</span>
        }
        @if (MaxLength.HasValue)
        {
            <span class="s-ta-count @(Length > MaxLength ? "s-over" : null)">
                @Length / @MaxLength
            </span>
        }
    </div>

    @if (EditContext is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="s-error" />
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool AutoGrow { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private ElementReference _ta;
    private IJSObjectReference? _grow;
    private string Uid { get; } = $"s{Guid.NewGuid():N}"[..9];
    private int Length => CurrentValue?.Length ?? 0;

    private Task OnInputAsync(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        return Task.CompletedTask;
    }

    protected override bool TryParseValueFromString(
        string? value, out string? result, out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    protected virtual async ValueTask DisposeAsyncCore()
    {
        if (Interop != null) await Interop.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoGrow)
            _grow = await Interop.AutoGrowAsync(_ta);
    }

    public async ValueTask DisposeAsync()
    {
        if (_grow is null) return;
        try { await _grow.InvokeVoidAsync("dispose"); await _grow.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
    }
}