@using System.Linq.Expressions
@inherits SComponentBase

<div class="s-sw-field @Class" style="@Style">
    <label class="s-sw @(Disabled ? "s-disabled" : null)">
        <input type="checkbox"
               class="s-sw-native"
               checked="@Value"
               disabled="@Disabled"
               @onchange="OnChangeAsync"
               @attributes="Attributes" />

        <span class="s-sw-track s-glass">
            <span class="s-sw-thumb"></span>
        </span>

        @if (ChildContent is not null || !string.IsNullOrEmpty(Label))
        {
            <span class="s-sw-label">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Label)))</span>
        }
    </label>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="s-hint s-sw-hint">@Hint</div>
    }

    @if (_edit is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="s-error" />
    }
</div>

@code {
    [CascadingParameter] private EditContext? _edit { get; set; }

    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private FieldIdentifier _field;

    protected override void OnParametersSet()
    {
        if (_edit is not null && ValueExpression is not null)
            _field = FieldIdentifier.Create(ValueExpression);
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        var v = e.Value is bool and true;
        if (v == Value) return;

        Value = v;
        await ValueChanged.InvokeAsync(v);

        if (_edit is not null && ValueExpression is not null)
            _edit.NotifyFieldChanged(_field);
    }
}