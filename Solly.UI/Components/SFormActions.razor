@inherits SComponentBase

<div class="@Cls("s-form-actions", AlignClass, Sticky ? "s-form-actions-sticky" : null)"
     style="@Style" @attributes="Attributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>start | center | end | between</summary>
    [Parameter] public string Align { get; set; } = "end";

    /// <summary>Stick to the bottom of a scrolling form.</summary>
    [Parameter] public bool Sticky { get; set; }

    private string AlignClass => Align switch
    {
        "start"   => "s-fa-start",
        "center"  => "s-fa-center",
        "between" => "s-fa-between",
        _         => "s-fa-end"
    };
}