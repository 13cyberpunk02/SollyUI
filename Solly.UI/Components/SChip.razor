@inherits SComponentBase

@if (Clickable || OnClick.HasDelegate)
{
    <button type="button"
            class="@RootClass"
            style="@Style"
            disabled="@Disabled"
            @onclick="OnClickAsync"
            @attributes="Attributes">
        @ChipInner
    </button>
}
else
{
    <span class="@RootClass" style="@Style" @attributes="Attributes">
        @ChipInner
    </span>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public SChipLevel Level { get; set; } = SChipLevel.Accent;
    [Parameter] public string? Icon { get; set; }

    /// <summary>Small avatar/dot on the left. Overrides Icon if both set.</summary>
    [Parameter] public string? AvatarSrc { get; set; }

    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    [Parameter] public bool Clickable { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Smaller, denser chip.</summary>
    [Parameter] public bool Small { get; set; }

    /// <summary>Outlined instead of filled.</summary>
    [Parameter] public bool Outline { get; set; }

    private bool Interactive => Clickable || OnClick.HasDelegate;

    private string RootClass => Cls(
        "s-chip",
        Level.ToCssClass(),
        Small ? "s-chip-sm" : null,
        Outline ? "s-chip-outline" : null,
        Interactive ? "s-chip-clickable" : null,
        Disabled ? "s-disabled" : null);

    private RenderFragment ChipInner => __builder =>
    {
        <text>
            @if (!string.IsNullOrEmpty(AvatarSrc))
            {
                <img class="s-chip-avatar" src="@AvatarSrc" alt="" />
            }
            else if (!string.IsNullOrEmpty(Icon))
            {
                <span class="s-chip-icon"><SIcon Name="@Icon" Size="@(Small ? 12 : 14)" /></span>
            }

            <span class="s-chip-text">@ChildContent</span>

            @if (Removable)
            {
                <span class="s-chip-x"
                      role="button"
                      tabindex="0"
                      aria-label="Remove"
                      @onclick:stopPropagation="true"
                      @onclick="OnRemoveAsync"
                      @onkeydown="OnRemoveKeyAsync">
                    <SIcon Name="@SIcons.X" Size="@(Small ? 11 : 13)" Weight="2.4" />
                </span>
            }
        </text>
    };

    private async Task OnClickAsync()
    {
        if (Disabled) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

    private async Task OnRemoveAsync()
    {
        if (Disabled) return;
        if (OnRemove.HasDelegate) await OnRemove.InvokeAsync();
    }

    private async Task OnRemoveKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await OnRemoveAsync();
    }
}