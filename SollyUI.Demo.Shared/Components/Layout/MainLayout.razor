@inherits LayoutComponentBase

<SAmbient/>

<CascadingValue Value="this">
    <SShell Floating @ref="_shell" CollapsedWidth="5rem">
        <SidebarContent>
            <SSidebar>
                <BrandContent>
                    <span class="demo-brand-dot"></span>
                    <span>Solly UI</span>
                    <span class="demo-env">@Env</span>
                </BrandContent>

                <ChildContent>
                    <SNavGroup Label="Getting started"/>
                    <SNavLink Href="" Icon="@SIcons.Home" Match="NavLinkMatch.All">Overview</SNavLink>
                    <SNavLink Href="theming" Icon="@SIcons.Palette">Theming</SNavLink>

                    <SNavGroup Label="Form controls"/>
                    <SNavLink Href="button" Icon="@SIcons.Cursor">Button</SNavLink>
                    <SNavLink Href="input" Icon="@SIcons.Type">Input</SNavLink>
                    <SNavLink Href="number" Icon="@SIcons.Sliders">Number Input</SNavLink>
                    <SNavLink Href="textarea" Icon="@SIcons.Lines">TextArea</SNavLink>
                    <SNavLink Href="checkbox" Icon="@SIcons.Check">Checkbox</SNavLink>
                    <SNavLink Href="radio" Icon="@SIcons.Circle">Radio</SNavLink>
                    <SNavLink Href="switch" Icon="@SIcons.Toggle">Switch</SNavLink>
                    <SNavLink Href="slider" Icon="@SIcons.Sliders">Slider</SNavLink>
                    <SNavLink Href="select" Icon="@SIcons.List">Select</SNavLink>
                    <SNavLink Href="datepicker" Icon="@SIcons.Calendar">Date Picker</SNavLink>
                    <SNavLink Href="rating" Icon="@SIcons.Star">Rating</SNavLink>
					<SNavLink Href="color-picker" Icon="@SIcons.Palette">Color Picker</SNavLink>
					<SNavLink Href="autocomplete" Icon="@SIcons.Search">Autocomplete</SNavLink>

                    <SNavGroup Label="Forms"/>
                    <SNavLink Href="form-layout" Icon="@SIcons.Clipboard">Form Layout</SNavLink>
                    <SNavLink Href="form" Icon="@SIcons.Clipboard">Validation</SNavLink>

                    <SNavGroup Label="Data display"/>
                    <SNavLink Href="table" Icon="@SIcons.Columns">Table</SNavLink>
                    <SNavLink Href="tree" Icon="@SIcons.Layers">Tree</SNavLink>
                    <SNavLink Href="card" Icon="@SIcons.Square">Card</SNavLink>
                    <SNavLink Href="badge" Icon="@SIcons.Badge">Badge</SNavLink>
                    <SNavLink Href="feedback" Icon="@SIcons.Info">Alert · Avatar · Progress</SNavLink>
                    <SNavLink Href="primitives" Icon="@SIcons.Layers">Chip · Skeleton · Empty</SNavLink>
                    <SNavLink Href="virtual-list" Icon="@SIcons.List">Virtual List</SNavLink>
                    <SNavLink Href="carousel" Icon="@SIcons.Layers">Carousel</SNavLink>
					<SNavLink Href="timeline" Icon="@SIcons.Lines">Timeline</SNavLink>

                    <SNavGroup Label="Navigation"/>
                    <SNavLink Href="tabs" Icon="@SIcons.Columns">Tabs</SNavLink>
                    <SNavLink Href="accordion" Icon="@SIcons.ChevronRight">Accordion</SNavLink>
                    <SNavLink Href="breadcrumbs" Icon="@SIcons.ChevronRight">Breadcrumbs</SNavLink>
                    <SNavLink Href="menu" Icon="@SIcons.Dots">Dropdown Menu</SNavLink>
					<SNavLink Href="stepper" Icon="@SIcons.Check">Stepper</SNavLink>

                    <SNavGroup Label="Overlays"/>
                    <SNavLink Href="modal" Icon="@SIcons.Square">Modal</SNavLink>
                    <SNavLink Href="drawer" Icon="@SIcons.PanelLeft">Drawer</SNavLink>
                    <SNavLink Href="popover" Icon="@SIcons.Layers">Popover</SNavLink>
                    <SNavLink Href="tooltip" Icon="@SIcons.Info">Tooltip</SNavLink>
                    <SNavLink Href="popconfirm" Icon="@SIcons.CircleAlert">Popconfirm</SNavLink>
                    <SNavLink Href="toast" Icon="@SIcons.Bell">Toast</SNavLink>					
                    <SNavLink Href="command-palette" Icon="@SIcons.Search">Command Palette</SNavLink>

                    <SNavGroup Label="Layout & shell"/>
                    <SNavLink Href="shell" Icon="@SIcons.PanelLeft">Shell</SNavLink>
                    <SNavLink Href="icon" Icon="@SIcons.Star">Icon</SNavLink>
                    <SNavLink Href="splitter" Icon="@SIcons.Columns">Splitter</SNavLink>
                </ChildContent>

                <FooterContent>
                    <SCollapseButton/>
                </FooterContent>
            </SSidebar>
        </SidebarContent>

        <HeaderContent>
            <SHeader>
                <StartContent>
                    <SBadge Level="SBadgeLevel.Neutral" Mono>v0.2.2</SBadge>
                </StartContent>
                <ChildContent>
                    <SThemeToggle/>
                </ChildContent>
            </SHeader>
        </HeaderContent>

        <ChildContent>
            <div class="demo-main">
                @Body
            </div>
        </ChildContent>
    </SShell>

    <SToastHost Position="@ToastPosition"/>
</CascadingValue>

@code {
    private SShell? _shell;

    public SToastPosition ToastPosition { get; private set; } = SToastPosition.BottomRight;

    private string Env => OperatingSystem.IsBrowser() ? "WASM" : "SERVER";

    public void SetToastPosition(SToastPosition p)
    {
        ToastPosition = p;
        StateHasChanged();
    }

}