@page "/input"
@using System.ComponentModel.DataAnnotations
@using SollyUI.Demo.Components.Shared

<DemoPage Title="Input" Subtitle="Inherits InputBase&lt;string?&gt; — full EditForm support.">

    <DemoBlock Title="Basic" Code="@_basicCode">
        <div class="demo-col">
            <SInput @bind-Value="_a" Label="Name" Placeholder="Jane Doe" />
            <span class="demo-note">Value: @(_a ?? "—")</span>
        </div>
    </DemoBlock>

    <DemoBlock Title="Icon, hint, clearable" Code="@_fullCode">
        <SInput @bind-Value="_b" Label="Search" Icon="@SIcons.Search"
                Placeholder="Type something…" Hint="Press Enter to submit" Clearable />
    </DemoBlock>

    <DemoBlock Title="Types" Code="@_typesCode">
        <div class="demo-col">
            <SInput @bind-Value="_email" Label="Email" Type="email" Placeholder="you@example.com" />
            <SInput @bind-Value="_pw" Label="Password" Type="password" />
            <SInput @bind-Value="_num" Label="Amount" Type="number" />
        </div>
    </DemoBlock>

    <DemoBlock Title="Disabled" Code="@_disabledCode">
        <SInput @bind-Value="_c" Label="Read only" Disabled />
    </DemoBlock>

    <DemoBlock Title="Validation"
               Description="Required is visual only — use data annotations for real validation."
               Code="@_validCode">
        <EditForm Model="_model" OnValidSubmit="() => _ok = true">
            <DataAnnotationsValidator />
            <div class="demo-col">
                <SInput @bind-Value="_model.Email" Label="Email" Required Clearable />
                <SButton Type="submit" Variant="SVariant.Primary">Submit</SButton>
                @if (_ok) { <span class="demo-note">Valid.</span> }
            </div>
        </EditForm>
    </DemoBlock>

</DemoPage>

@code {
    class Model
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Not a valid email")]
        public string? Email { get; set; }
    }

    Model _model = new();
    bool _ok;

    string? _a, _b, _c = "Can't touch this", _email, _pw, _num;

    const string _basicCode = """
<SInput @bind-Value="_name" Label="Name" Placeholder="Jane Doe" />
""";

    const string _fullCode = """
<SInput @bind-Value="_q" Label="Search" Icon="@SIcons.Search"
        Placeholder="Type something…" Hint="Press Enter to submit" Clearable />
""";

    const string _typesCode = """
<SInput @bind-Value="_email" Label="Email" Type="email" />
<SInput @bind-Value="_pw" Label="Password" Type="password" />
<SInput @bind-Value="_num" Label="Amount" Type="number" />
""";

    const string _disabledCode = """
<SInput @bind-Value="_x" Label="Read only" Disabled />
""";

    const string _validCode = """
class Model
{
    [Required] [EmailAddress]
    public string? Email { get; set; }
}

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <SInput @bind-Value="_model.Email" Label="Email" Required Clearable />
    <SButton Type="submit" Variant="SVariant.Primary">Submit</SButton>
</EditForm>
""";
}