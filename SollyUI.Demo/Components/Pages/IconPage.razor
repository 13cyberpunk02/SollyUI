@page "/icon"
@using System.Reflection
@using SollyUI.Demo.Components.Shared

<DemoPage Title="Icon" Subtitle="Compile-time SVG constants. No runtime fetch, no bundle bloat.">

    <DemoBlock Title="All icons" Code="@_usageCode">
        <div class="demo-icons">
            @foreach (var (name, path) in _all)
            {
                <div class="demo-icon-cell">
                    <SIcon Name="@path" Size="20" />
                    <code>@name</code>
                </div>
            }
        </div>
    </DemoBlock>

    <DemoBlock Title="Sizes" Code="@_sizeCode">
        <div class="demo-row">
            <SIcon Name="@SIcons.Star" Size="14" />
            <SIcon Name="@SIcons.Star" Size="18" />
            <SIcon Name="@SIcons.Star" Size="24" />
            <SIcon Name="@SIcons.Star" Size="32" />
            <SIcon Name="@SIcons.Star" Size="48" />
        </div>
    </DemoBlock>

    <DemoBlock Title="Color"
               Description="Icons use currentColor — set color on a parent or on the icon."
               Code="@_colorCode">
        <div class="demo-row">
            <SIcon Name="@SIcons.Star" Size="24" Style="color: var(--s-accent);" />
            <SIcon Name="@SIcons.Star" Size="24" Style="color: var(--s-danger);" />
            <SIcon Name="@SIcons.Star" Size="24" Style="color: #f5a524;" />
        </div>
    </DemoBlock>

    <DemoBlock Title="Animated" Code="@_spinCode">
        <div class="demo-row">
            <SIcon Name="@SIcons.Spinner" Size="24" Class="s-spin" />
            <SIcon Name="@SIcons.Loader" Size="24" Class="s-spin" />
        </div>
    </DemoBlock>

    <DemoBlock Title="Custom icons"
               Description="Any SVG path markup on a 24×24 viewBox."
               Code="@_customCode">
        <div class="demo-row">
            <SIcon Name="@Heart" Size="24" Style="color: var(--s-danger);" />
        </div>
    </DemoBlock>

</DemoPage>

@code {
    const string Heart = "<path d='M19 14c1.5-1.5 3-3.5 3-5.5A5.5 5.5 0 0 0 12 5a5.5 5.5 0 0 0-10 3.5c0 2 1.5 4 3 5.5l7 7Z'/>";

    static readonly (string Name, string Path)[] _all = typeof(SIcons)
        .GetFields(BindingFlags.Public | BindingFlags.Static)
        .Where(f => f.IsLiteral && f.FieldType == typeof(string))
        .Select(f => (f.Name, (string)f.GetRawConstantValue()!))
        .OrderBy(x => x.Name)
        .ToArray();

    const string _usageCode = """
<SIcon Name="@SIcons.Check" />
""";

    const string _sizeCode = """
<SIcon Name="@SIcons.Star" Size="14" />
<SIcon Name="@SIcons.Star" Size="48" />
""";

    const string _colorCode = """
<SIcon Name="@SIcons.Star" Style="color: var(--s-accent);" />
""";

    const string _spinCode = """
<SIcon Name="@SIcons.Spinner" Class="s-spin" />
""";

    const string _customCode = """
public static class MyIcons
{
    public const string Heart = "<path d='M19 14c1.5-1.5 3-3.5 3-5.5A5.5 5.5 0 0 0 12 5a5.5 5.5 0 0 0-10 3.5c0 2 1.5 4 3 5.5l7 7Z'/>";
}

<SIcon Name="@MyIcons.Heart" Size="24" />
""";
}