@page "/drawer"

<DemoPage Title="Drawer" Subtitle="Выезжающая панель слева или справа. Focus trap, блокировка скролла, Escape.">

    <DemoBlock Title="Left & right" Code="@_basicCode">
        <div class="demo-row">
            <SButton Icon="@SIcons.PanelLeft" OnClick="@(() => _left = true)">Открыть слева</SButton>
            <SButton Icon="@SIcons.Layers" OnClick="@(() => _right = true)">Открыть справа</SButton>
        </div>

        <SDrawer @bind-Open="_left" Side="SDrawerSide.Left" Title="Навигация">
            <div class="demo-col" style="max-width:none;gap:4px;">
                <SNavLink Href="button" Icon="@SIcons.Cursor">Button</SNavLink>
                <SNavLink Href="input" Icon="@SIcons.Type">Input</SNavLink>
                <SNavLink Href="table" Icon="@SIcons.Columns">Table</SNavLink>
            </div>
        </SDrawer>

        <SDrawer @bind-Open="_right" Side="SDrawerSide.Right" Title="Детали">
            <ChildContent>
                <p>Панель справа — типичное место для деталей записи или фильтров.</p>
                <SAlert Level="SAlertLevel.Info" Soft>Escape или клик по фону закроют панель.</SAlert>
            </ChildContent>
            <FooterContent>
                <SButton Variant="SVariant.Ghost" OnClick="@(() => _right = false)">Отмена</SButton>
                <SButton Variant="SVariant.Primary" OnClick="@(() => _right = false)">Сохранить</SButton>
            </FooterContent>
        </SDrawer>
    </DemoBlock>

    <DemoBlock Title="Filters"
               Description="Частый сценарий — панель фильтров справа."
               Code="@_filterCode">
        <SButton Icon="@SIcons.Sliders" OnClick="@(() => _filters = true)">Фильтры</SButton>

        <SDrawer @bind-Open="_filters" Side="SDrawerSide.Right" Title="Фильтры" Width="24rem">
            <ChildContent>
                <div class="demo-col" style="max-width:none;gap:20px;">
                    <SSelect TValue="string" Items="@(["Все","Активные","Архив"])"
                             Value="@_status" ValueChanged="@(v => _status = v)" Label="Статус" />
                    <SSlider Value="_price" ValueChanged="@((v) => _price = v)"
                             Label="Цена до" Min="0" Max="1000" Format="@(v => $"{v:0} €")" />
                    <SCheckbox @bind-Value="_inStock" Label="Только в наличии" />
                </div>
            </ChildContent>
            <FooterContent>
                <SButton Variant="SVariant.Ghost" OnClick="@(ResetFilters)">Сбросить</SButton>
                <SButton Variant="SVariant.Primary" OnClick="@(() => _filters = false)">Применить</SButton>
            </FooterContent>
        </SDrawer>
    </DemoBlock>

    <DemoBlock Title="Programmatic" Code="@_apiCode">
        <div class="demo-row">
            <SButton OnClick="@(() => _drawer!.OpenAsync())">Open via ref</SButton>
        </div>
        <SDrawer @ref="_drawer" Side="SDrawerSide.Right" Title="Через ref">
            Открыто вызовом OpenAsync().
        </SDrawer>
    </DemoBlock>

</DemoPage>

@code {
    bool _left, _right, _filters;
    SDrawer? _drawer;

    string? _status = "Все";
    double _price = 500;
    bool _inStock = true;

    void ResetFilters() { _status = "Все"; _price = 500; _inStock = true; }

    const string _basicCode = """
<SButton OnClick="() => _open = true">Открыть</SButton>

<SDrawer @bind-Open="_open" Side="SDrawerSide.Right" Title="Детали">
    <ChildContent>…</ChildContent>
    <FooterContent>
        <SButton Variant="SVariant.Primary" OnClick="() => _open = false">Сохранить</SButton>
    </FooterContent>
</SDrawer>
""";

    const string _filterCode = """
<SDrawer @bind-Open="_filters" Side="SDrawerSide.Right" Title="Фильтры" Width="24rem">
    <ChildContent>
        <SSelect … Label="Статус" />
        <SSlider … Label="Цена до" />
    </ChildContent>
    <FooterContent>
        <SButton OnClick="Apply">Применить</SButton>
    </FooterContent>
</SDrawer>
""";

    const string _apiCode = """
<SDrawer @ref="_drawer" Side="SDrawerSide.Right" Title="…">…</SDrawer>

<SButton OnClick="() => _drawer!.OpenAsync()">Open</SButton>

@code { SDrawer? _drawer; }
""";
}