@page "/"
@using SollyUI.Demo.Components.Shared

<DemoPage Title="Solly.UI" Subtitle="Glassmorphism components for Blazor.">
    <div class="demo-cards">
        <a class="demo-card s-glass" href="button">
            <SIcon Name="@SIcons.Cursor" Size="20" />
            <strong>Button</strong>
            <span>Variants, icons, async spinner, pointer ripple.</span>
        </a>
        <a class="demo-card s-glass" href="input">
            <SIcon Name="@SIcons.Type" Size="20" />
            <strong>Input</strong>
            <span>Labels, icons, hints, clearable, validation.</span>
        </a>
        <a class="demo-card s-glass" href="select">
            <SIcon Name="@SIcons.List" Size="20" />
            <strong>Select</strong>
            <span>Generic, searchable, multiple, async source.</span>
        </a>
        <a class="demo-card s-glass" href="datepicker">
            <SIcon Name="@SIcons.Calendar" Size="20" />
            <strong>DatePicker</strong>
            <span>Culture-aware calendar with min/max.</span>
        </a>
        <a class="demo-card s-glass" href="theming">
            <SIcon Name="@SIcons.Palette" Size="20" />
            <strong>Theming</strong>
            <span>Dark, light, custom tokens, persistence.</span>
        </a>
        <a class="demo-card s-glass" href="form">
            <SIcon Name="@SIcons.Clipboard" Size="20" />
            <strong>Full form</strong>
            <span>Everything together with validation.</span>
        </a>
        <a class="demo-card s-glass" href="modal">
            <SIcon Name="@SIcons.Layers" Size="20" />
            <strong>Modal</strong>
            <span>Focus trap, scroll lock, confirm dialogs.</span>
        </a>
        <a class="demo-card s-glass" href="toast">
            <SIcon Name="@SIcons.Info" Size="20" />
            <strong>Toast</strong>
            <span>Service-driven notifications with undo actions.</span>
        </a>
    </div>
</DemoPage>