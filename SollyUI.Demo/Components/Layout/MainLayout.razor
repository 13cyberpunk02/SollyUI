@inherits LayoutComponentBase

<SAmbient />

<CascadingValue Value="this">
    <div class="demo-shell">
        <aside class="demo-sidebar">
            <div class="demo-brand">
                <span class="demo-brand-dot"></span>
                Glassy.UI
                <span class="demo-env">@Env</span>
            </div>

            <nav class="demo-nav">
                <div class="demo-nav-group">Getting started</div>
                <DemoLink Href="" Icon="@SIcons.Home" Match="NavLinkMatch.All">Overview</DemoLink>

                <div class="demo-nav-group">Inputs</div>
                <DemoLink Href="button" Icon="@SIcons.Cursor">Button</DemoLink>
                <DemoLink Href="input" Icon="@SIcons.Type">Input</DemoLink>
                <DemoLink Href="number" Icon="@SIcons.Sliders">NumberInput</DemoLink>
                <DemoLink Href="textarea" Icon="@SIcons.Lines">TextArea</DemoLink>
                <DemoLink Href="checkbox" Icon="@SIcons.Check">Checkbox</DemoLink>
                <DemoLink Href="radio" Icon="@SIcons.Circle">Radio</DemoLink>
                <DemoLink Href="switch" Icon="@SIcons.Toggle">Switch</DemoLink>
                <DemoLink Href="slider" Icon="@SIcons.Sliders">Slider</DemoLink>
                <DemoLink Href="select" Icon="@SIcons.List">Select</DemoLink>
                <DemoLink Href="datepicker" Icon="@SIcons.Calendar">DatePicker</DemoLink>

                <div class="demo-nav-group">Display</div>
                <DemoLink Href="badge" Icon="@SIcons.Star">Badge</DemoLink>
                <DemoLink Href="icon" Icon="@SIcons.Star">Icon</DemoLink>
                <DemoLink Href="tabs" Icon="@SIcons.Columns">Tabs</DemoLink>

                <div class="demo-nav-group">Overlays</div>
                <DemoLink Href="tooltip" Icon="@SIcons.Info">Tooltip</DemoLink>
                <DemoLink Href="popover" Icon="@SIcons.Layers">Popover</DemoLink>
                <DemoLink Href="modal" Icon="@SIcons.Square">Modal</DemoLink>
                <DemoLink Href="toast" Icon="@SIcons.Bell">Toast</DemoLink>

                <div class="demo-nav-group">Other</div>
                <DemoLink Href="theming" Icon="@SIcons.Palette">Theming</DemoLink>
                <DemoLink Href="form" Icon="@SIcons.Clipboard">Full form</DemoLink>
            </nav>
        </aside>

        <div class="demo-content">
            <header class="demo-topbar">
                <SThemeToggle />
            </header>
            <main class="demo-main">
                @Body
            </main>
        </div>
    </div>

    <SToastHost Position="@ToastPosition" />
</CascadingValue>

@code {
    public SToastPosition ToastPosition { get; private set; } = SToastPosition.BottomRight;

    private string Env => OperatingSystem.IsBrowser() ? "WASM" : "SERVER";

    public void SetToastPosition(SToastPosition p)
    {
        ToastPosition = p;
        StateHasChanged();
    }
}