@inherits LayoutComponentBase

<SAmbient />

<CascadingValue Value="this">
    <SShell Floating @ref="_shell" CollapsedWidth="5rem">
        <SidebarContent>
            <SSidebar>
                <BrandContent>
                    <span class="demo-brand-dot"></span>
                    <span>Solly UI</span>
                    <span class="demo-env">@Env</span>
                </BrandContent>

                <ChildContent>
                    <SNavGroup Label="Getting started" />
                    <SNavLink Href="" Icon="@SIcons.Home" Match="NavLinkMatch.All">Overview</SNavLink>

                    <SNavGroup Label="Inputs" />
                    <SNavLink Href="button" Icon="@SIcons.Cursor">Button</SNavLink>
                    <SNavLink Href="input" Icon="@SIcons.Type">Input</SNavLink>
                    <SNavLink Href="number" Icon="@SIcons.Sliders">NumberInput</SNavLink>
                    <SNavLink Href="textarea" Icon="@SIcons.Lines">TextArea</SNavLink>
                    <SNavLink Href="checkbox" Icon="@SIcons.Check">Checkbox</SNavLink>
                    <SNavLink Href="radio" Icon="@SIcons.Circle">Radio</SNavLink>
                    <SNavLink Href="switch" Icon="@SIcons.Toggle">Switch</SNavLink>
                    <SNavLink Href="slider" Icon="@SIcons.Sliders">Slider</SNavLink>
                    <SNavLink Href="select" Icon="@SIcons.List">Select</SNavLink>
                    <SNavLink Href="datepicker" Icon="@SIcons.Calendar">DatePicker</SNavLink>

                    <SNavGroup Label="Data" />
                    <SNavLink Href="table" Icon="@SIcons.Columns">Table</SNavLink>
                    
                    <SNavGroup Label="Layout" />
                    <SNavLink Href="card" Icon="@SIcons.Square">Card</SNavLink>
                    <SNavLink Href="shell" Icon="@SIcons.PanelLeft">Shell</SNavLink>
                    <SNavLink Href="tabs" Icon="@SIcons.Columns">Tabs</SNavLink>

                    <SNavGroup Label="Display" />
                    <SNavLink Href="badge" Icon="@SIcons.Star">Badge</SNavLink>
                    <SNavLink Href="icon" Icon="@SIcons.Star">Icon</SNavLink>

                    <SNavGroup Label="Overlays" />
                    <SNavLink Href="tooltip" Icon="@SIcons.Info">Tooltip</SNavLink>
                    <SNavLink Href="popover" Icon="@SIcons.Layers">Popover</SNavLink>
                    <SNavLink Href="modal" Icon="@SIcons.Square">Modal</SNavLink>
                    <SNavLink Href="toast" Icon="@SIcons.Bell">Toast</SNavLink>

                    <SNavGroup Label="Other" />
                    <SNavLink Href="theming" Icon="@SIcons.Palette">Theming</SNavLink>
                    <SNavLink Href="form" Icon="@SIcons.Clipboard">Full form</SNavLink>
                </ChildContent>

                <FooterContent>
                    <SCollapseButton />
                </FooterContent>
            </SSidebar>
        </SidebarContent>

        <HeaderContent>
            <SHeader>
                <StartContent>
                    <SBadge Level="SBadgeLevel.Neutral" Mono>v0.1.0</SBadge>
                </StartContent>
                <ChildContent>
                    <SThemeToggle />
                </ChildContent>
            </SHeader>
        </HeaderContent>

        <ChildContent>
            <div class="demo-main">
                @Body
            </div>
        </ChildContent>
    </SShell>

    <SToastHost Position="@ToastPosition" />
</CascadingValue>

@code {
    private SShell? _shell;

    public SToastPosition ToastPosition { get; private set; } = SToastPosition.BottomRight;

    private string Env => OperatingSystem.IsBrowser() ? "WASM" : "SERVER";

    public void SetToastPosition(SToastPosition p)
    {
        ToastPosition = p;
        StateHasChanged();
    }
}